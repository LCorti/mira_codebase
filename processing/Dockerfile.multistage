# Multi-stage build for maximum size reduction
FROM python:3.13-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /bin/

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --locked --no-dev --compile-bytecode

# Download NLTK data and verify spaCy model
RUN uv run python -c "import nltk; nltk.download('punkt_tab')"
RUN uv run python -c "import spacy; nlp = spacy.load('en_core_web_sm'); print('spaCy model loaded successfully')"

# Clean up cache to reduce layer size - more aggressive cleanup
RUN uv cache prune --ci && \
    rm -rf /root/.cache/pip && \
    find /app/.venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /app/.venv -type f -name "*.pyc" -delete && \
    find /app/.venv -type f -name "*.pyo" -delete

# Production stage
FROM python:3.13-slim-bookworm AS production

# Install only runtime dependencies (if any are needed)
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /bin/

WORKDIR /app

# Copy Python environment and application from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/nltk_data /root/nltk_data

# Copy application code
COPY . .

# Ensure logs directory exists
RUN mkdir -p /app/app/logs && chmod 755 /app/app/logs

# Use the virtual environment
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--lifespan=on"]