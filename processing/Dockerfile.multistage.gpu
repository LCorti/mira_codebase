# Multi-stage build for GPU support with CUDA
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS builder

# Set timezone non-interactively
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Python 3.13 and build dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.13 \
    python3.13-venv \
    python3.13-dev \
    cmake \
    pkg-config \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set python3.13 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.13 1

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /bin/

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies with CUDA support
RUN uv sync --locked --no-dev --compile-bytecode

# Download NLTK data and verify spaCy model
RUN uv run python -c "import nltk; nltk.download('punkt_tab')"
RUN uv run python -c "import spacy; nlp = spacy.load('en_core_web_sm'); print('spaCy model loaded successfully')"

# Clean up cache to reduce layer size
RUN uv cache prune --ci

# Production stage with CUDA runtime
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS production

# Set timezone non-interactively
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Python 3.13 runtime and build tools (needed for PyStemmer)
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.13 \
    python3.13-venv \
    python3.13-dev \
    build-essential \
    gcc \
    g++ \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set python3.13 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.13 1

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /bin/

WORKDIR /app

# Copy Python environment and application from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/nltk_data /root/nltk_data

# Copy application code
COPY . .

# Ensure logs directory exists
RUN mkdir -p /app/app/logs && chmod 755 /app/app/logs

# Set environment variables for CUDA
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Run the application
CMD ["uv", "run", "python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
