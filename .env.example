# Environment configuration for Both Services
# Copy this file and configure it for your specific setup

# General Variables
APP_NAME="DTK"
APP_VERSION="0.0.1"
BUILD_DATE="02-10-2026"
LICENSE="MIT License"

LOGGING_LEVEL="DEBUG" # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Variables
MONGO_USERNAME="user"
MONGO_PASSWORD="password"
MONGO_HOST="processing_db" # Use container name for internal communication
MONGO_PORT="27017"

# Navigation Service Variables
NAVIGATION_SERVICE_URL="http://<IP>:8000"

DJANGO_SECRET_KEY="RANDOM_DJANGO_SECRET_KEY"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=["localhost","127.0.0.1"]
REPORT_DIR="/reports" # Directory to save generated reports

# Processing Service Variables
PROCESSING_SERVICE_URL="http://172.18.0.3:8000"

QUEUE_WORKERS=1 # Number of worker processes for job queue
HF_HOME="/.cache/huggingface" # Hugging Face cache directory
HF_TOKEN="ADD_YOUR_TOKEN"
SEED_DB_ON_BUILD=False # Whether to seed the database on build
